# Copy to .env.local. With none of these set the app runs on the local file-backed
# database (.data/db.json) and a "sign in as" picker — no accounts to provision.

# Supabase project settings → Data API (older UI: API).
# Nothing here is a secret: the anon key is designed for public clients and row-level
# security is the permission boundary. Never set the service-role key — it is not read.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Where magic links come back to. http://localhost:3000 locally, your deployment URL in
# production. No trailing slash.
SITE_URL=http://localhost:3000

# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SITE_URL are still
# read as a fallback, but prefer the names above. Next.js inlines NEXT_PUBLIC_* into the
# bundle at build time, so a value withheld from the build — which is what Vercel's
# "Sensitive" environment variables are — is baked in as undefined and can never be
# recovered at runtime. Nothing in this app calls Supabase from the browser, so the prefix
# buys nothing.

# Force an adapter. Leave unset to auto-detect: Supabase when configured, local otherwise.
# In production the local store is refused outright rather than silently used.
# DATA_ADAPTER=local
