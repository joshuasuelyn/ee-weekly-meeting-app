# Copy to .env.local. With none of these set the app runs on the local file-backed
# database (.data/db.json) and a "sign in as" picker — no accounts to provision.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where magic links come back to. http://localhost:3000 locally, your Vercel URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Force an adapter. Leave unset to auto-detect: Supabase when configured, local otherwise.
# DATA_ADAPTER=local
